<?xml version="1.0" encoding="utf-8"?>
<!--
    Kavach-UPI Accessibility Service Metadata Configuration
    - Listens strictly to TYPE_WINDOW_STATE_CHANGED and TYPE_WINDOW_CONTENT_CHANGED
      to detect UPI/Banking app launches and sensitive payment/PIN UI screens.
    - Enables canRetrieveWindowContent="true" for bounded 15-layer DFS UI inspection.
    -Omits packageNames filter intentionally so Kavach can detect BOTH protected
      banking/UPI packages AND concurrent remote-access / screen-share packages
      (AnyDesk, TeamViewer, QuickSupport, RustDesk, etc.) transitioning across windows.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackSpoken|feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.example.MainActivity" />
