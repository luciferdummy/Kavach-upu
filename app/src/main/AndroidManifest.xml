<?xml version="1.0" encoding="utf-8"?>
<!--
    Kavach-UPI Zero-Trust Manifest (Target SDK 34 / Min SDK 26)
    100% Edge-Computed Autonomous Security Architecture:
    - ZERO network permissions (NO android.permission.INTERNET) so sensitive window
      metadata or UI trees can mathematically never leave the user's device.
    - Declares SYSTEM_ALERT_WINDOW for programmatic touch-blocking overlay mounting.
    - Declares PACKAGE_USAGE_STATS for UsageStatsManager & AppOpsManager media-projection queries.
    - Declares FOREGROUND_SERVICE & FOREGROUND_SERVICE_SPECIAL_USE (Android 14 / SDK 34)
      alongside QUERY_ALL_PACKAGES / <queries> visibility for UPI & remote-access packages.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay permission fallback when mounting via TYPE_APPLICATION_OVERLAY -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- UsageStatsManager timeline & AppOpsManager media-projection inspection -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground service declarations for SDK 34 continuous security telemetry -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Android 11+ (API 30+) Package Visibility:
        Explicitly declare UPI, banking,remote-desktop, and TTS engine queries so Kavach-UPI
        can inspect installed status and resolve package labels without broad QUERY_ALL_PACKAGES.
    -->
    <queries>
        <!-- Text-To-Speech Engine Discovery (Android 11+ requirement for TextToSpeech) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>

        <!-- Protected UPI & Banking Target Packages -->
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.whatsapp" />
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="com.sbi.lotusintouch" />
        <package android:name="com.csam.icici.bank.imobile" />
        <package android:name="com.snapwork.hdfc" />
        <package android:name="com.axis.mobile" />
        <package android:name="com.kotak.mobile.k811" />

        <!-- Known Remote-Access & Screen-Sharing Threat Packages -->
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.teamviewer.market.mobile" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.realvnc.viewer.android" />
        <package android:name="com.splashtop.sos" />
        <package android:name="com.zoho.assist.agent" />
        <package android:name="com.awesun.control" />
        <package android:name="com.airdroid.airsos" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="com.google.android.apps.tachyon" />
        <package android:name="com.discord" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Main Zero-Trust Security Command Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            KavachAccessibilityService:
            Requires android.permission.BIND_ACCESSIBILITY_SERVICE so only the Android OS
            system process can bind to this service. Also declares foregroundServiceType="specialUse"
            for resilient zero-trust protection under Android 14 (SDK 34).
        -->
        <service
            android:name=".KavachAccessibilityService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device zero-trust financial anti-scam accessibility &amp; media-projection monitor" />
        </service>

    </application>

</manifest>
